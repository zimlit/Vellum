// Test: out[i] = i * mul, through a buffer device address.
#version 460
#extension GL_EXT_buffer_reference : require

layout(local_size_x = 64) in;

layout(buffer_reference, std430) writeonly buffer Words {
    uint data[];
};

layout(push_constant) uniform Push {
    Words out_buf;
    uint count;
    uint mul;
};

void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i < count) {
        out_buf.data[i] = i * mul;
    }
}
