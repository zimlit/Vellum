# Terminfo for vellum. build.rs compiles it with `tic -x`, and the binary
# installs it under $XDG_DATA_HOME/vellum/terminfo (see src/terminfo.rs).
#
# Written for vellum, not inherited: every capability here is something
# vellum does. The tests in src/terminfo.rs hold it to that. Each sequence
# goes through the terminal core and must be handled, every key must be
# what the key encoder sends, and the XTGETTCAP table must agree. Started
# from xterm-256color, without what vellum doesn't do (yet): left/right
# margins, the printer, the visual bell (DECSCNM), meta mode, mouse
# reporting, the clipboard (OSC 52) and the title stack.
#
# The name keeps the `xterm-` prefix because programs pick their terminal
# support from it (Emacs loads term/xterm.el for any `xterm-*`).
#
# SIZE: the compiled entry must stay at or under 4096 bytes. The narrow
# ncurses library (libtinfo.so, which Emacs and bash link here) refuses
# larger entries as "not defined"; build.rs checks.
#
# Not set on purpose: the `RGB` flag. With it, ncurses reads setaf/setab as
# direct colors, which breaks programs using the 256-color palette.
xterm-vellum|vellum terminal emulator,

# Behavior.
	am, bce, ccc, OTbs, km, mir, msgr, npc, xenl,
	cols#80, it#8, lines#24, colors#0x100, pairs#0x10000,

# Cursor movement and addressing.
	cr=\r, cub1=^H, cud1=\n, cuf1=\E[C, cuu1=\E[A,
	cub=\E[%p1%dD, cud=\E[%p1%dB, cuf=\E[%p1%dC, cuu=\E[%p1%dA,
	cup=\E[%i%p1%d;%p2%dH, home=\E[H,
	hpa=\E[%i%p1%dG, vpa=\E[%i%p1%dd,
	sc=\E7, rc=\E8, nel=\EE,
	ind=\n, ri=\EM, indn=\E[%p1%dS, rin=\E[%p1%dT,
	csr=\E[%i%p1%d;%p2%dr,
	ht=^I, cbt=\E[Z, hts=\EH, tbc=\E[3g,
	bel=^G,

# Editing.
	clear=\E[H\E[2J, ed=\E[J, el=\E[K, el1=\E[1K, E3=\E[3J,
	dch1=\E[P, dch=\E[%p1%dP, ich=\E[%p1%d@, ech=\E[%p1%dX,
	dl1=\E[M, dl=\E[%p1%dM, il1=\E[L, il=\E[%p1%dL,
	smir=\E[4h, rmir=\E[4l,
	rep=%p1%c\E[%p2%{1}%-%db,

# Modes.
	smam=\E[?7h, rmam=\E[?7l,
	smcup=\E[?1049h, rmcup=\E[?1049l,
	smkx=\E[?1h\E=, rmkx=\E[?1l\E>,
	civis=\E[?25l, cnorm=\E[?12l\E[?25h, cvvis=\E[?12;25h,
	is2=\E[!p\E>, rs1=\Ec\E]104^G, rs2=\E[!p\E>,

# Attributes and colors.
	sgr0=\E(B\E[m,
	sgr=%?%p9%t\E(0%e\E(B%;\E[0%?%p6%t;1%;%?%p5%t;2%;%?%p2%t;4%;%?%p1%p3%|%t;7%;%?%p4%t;5%;%?%p7%t;8%;m,
	bold=\E[1m, dim=\E[2m, blink=\E[5m, invis=\E[8m, rev=\E[7m,
	sitm=\E[3m, ritm=\E[23m, smso=\E[7m, rmso=\E[27m,
	smul=\E[4m, rmul=\E[24m, smxx=\E[9m, rmxx=\E[29m,
	acsc=``aaffggiijjkkllmmnnooppqqrrssttuuvvwwxxyyzz{{||}}~~,
	smacs=\E(0, rmacs=\E(B,
	setaf=\E[%?%p1%{8}%<%t3%p1%d%e%p1%{16}%<%t9%p1%{8}%-%d%e38;5;%p1%d%;m,
	setab=\E[%?%p1%{8}%<%t4%p1%d%e%p1%{16}%<%t10%p1%{8}%-%d%e48;5;%p1%d%;m,
	op=\E[39;49m, AX,
	initc=\E]4;%p1%d;rgb\:%p2%{255}%*%{1000}%/%2.2X/%p3%{255}%*%{1000}%/%2.2X/%p4%{255}%*%{1000}%/%2.2X\E\\,
	oc=\E]104^G,

# 24-bit color, always as SGR 38/48;2. Emacs uses setf24/setb24 first;
# without them it falls back to a format that sends RGB values below 8 as
# palette colors 0-7 (so #000000 came out as palette black). Tc is tmux's
# flag for the same.
	setf24=\E[38;2;%p1%{65536}%/%d;%p1%{256}%/%{255}%&%d;%p1%{255}%&%dm,
	setb24=\E[48;2;%p1%{65536}%/%d;%p1%{256}%/%{255}%&%d;%p1%{255}%&%dm,
	Tc,

# Styled underlines (4:n) and their color (58).
	Smulx=\E[4:%p1%dm,
	Setulc=\E[58:2::%p1%{65536}%/%d:%p1%{256}%/%{255}%&%d:%p1%{255}%&%dm,

# Cursor: style (DECSCUSR) and color (OSC 12 / 112).
	Ss=\E[%p1%d q, Se=\E[0 q,
	Cs=\E]12;%p1%s^G, Cr=\E]112^G,

# Title (OSC 0/2), bracketed paste, focus events, synchronized output.
	XT,
	BE=\E[?2004h, BD=\E[?2004l, PS=\E[200~, PE=\E[201~,
	XF, fe=\E[?1004h, fd=\E[?1004l, kxIN=\E[I, kxOUT=\E[O,
	Sync=\E[?2026%?%p1%{1}%-%tl%eh%;,

# Queries and the shapes of their replies.
	u7=\E[6n, u6=\E[%i%d;%dR,
	u9=\E[c, u8=\E[?%[;0123456789]c,
	RV=\E[>c, rv=\E\\[>1;[0-9]+;0c,
	XR=\E[>0q, xr=\EP>\\|vellum\\(([0-9.]+)\\)\E\\\\,

# Keys, as the key encoder sends them (after smkx: application cursor
# keys and keypad).
	kbs=\177, kcbt=\E[Z, kent=\EOM,
	kcuu1=\EOA, kcud1=\EOB, kcuf1=\EOC, kcub1=\EOD,
	khome=\EOH, kend=\EOF, kbeg=\EOE,
	kich1=\E[2~, kdch1=\E[3~, kpp=\E[5~, knp=\E[6~,
	kri=\E[1;2A, kind=\E[1;2B, kUP=\E[1;2A, kDN=\E[1;2B, kRIT=\E[1;2C, kLFT=\E[1;2D,
	kHOM=\E[1;2H, kEND=\E[1;2F, kIC=\E[2;2~, kDC=\E[3;2~,
	kPRV=\E[5;2~, kNXT=\E[6;2~,
	kf1=\EOP, kf2=\EOQ, kf3=\EOR, kf4=\EOS,
	kf5=\E[15~, kf6=\E[17~, kf7=\E[18~, kf8=\E[19~,
	kf9=\E[20~, kf10=\E[21~, kf11=\E[23~, kf12=\E[24~,
# F13-F24 Shift, F25-F36 Ctrl, F37-F48 Ctrl+Shift, F49-F60 Alt,
# F61-F63 Alt+Shift (F1-F3).
	kf13=\E[1;2P, kf14=\E[1;2Q, kf15=\E[1;2R, kf16=\E[1;2S,
	kf17=\E[15;2~, kf18=\E[17;2~, kf19=\E[18;2~, kf20=\E[19;2~,
	kf21=\E[20;2~, kf22=\E[21;2~, kf23=\E[23;2~, kf24=\E[24;2~,
	kf25=\E[1;5P, kf26=\E[1;5Q, kf27=\E[1;5R, kf28=\E[1;5S,
	kf29=\E[15;5~, kf30=\E[17;5~, kf31=\E[18;5~, kf32=\E[19;5~,
	kf33=\E[20;5~, kf34=\E[21;5~, kf35=\E[23;5~, kf36=\E[24;5~,
	kf37=\E[1;6P, kf38=\E[1;6Q, kf39=\E[1;6R, kf40=\E[1;6S,
	kf41=\E[15;6~, kf42=\E[17;6~, kf43=\E[18;6~, kf44=\E[19;6~,
	kf45=\E[20;6~, kf46=\E[21;6~, kf47=\E[23;6~, kf48=\E[24;6~,
	kf49=\E[1;3P, kf50=\E[1;3Q, kf51=\E[1;3R, kf52=\E[1;3S,
	kf53=\E[15;3~, kf54=\E[17;3~, kf55=\E[18;3~, kf56=\E[19;3~,
	kf57=\E[20;3~, kf58=\E[21;3~, kf59=\E[23;3~, kf60=\E[24;3~,
	kf61=\E[1;4P, kf62=\E[1;4Q, kf63=\E[1;4R,
# The keypad in application mode (Num Lock on).
	ka1=\EOw, ka2=\EOx, ka3=\EOy, kb1=\EOt, kb2=\EOu, kb3=\EOv,
	kc1=\EOq, kc2=\EOr, kc3=\EOs, kp5=\EOE,
	kpADD=\EOk, kpSUB=\EOm, kpMUL=\EOj, kpDIV=\EOo,
	kpDOT=\EOn, kpCMA=\EOl, kpZRO=\EOp,
# Modified editing and cursor keys: 3 Alt, 4 Alt+Shift, 5 Ctrl,
# 6 Ctrl+Shift, 7 Ctrl+Alt.
	kUP3=\E[1;3A, kUP4=\E[1;4A, kUP5=\E[1;5A, kUP6=\E[1;6A, kUP7=\E[1;7A,
	kDN3=\E[1;3B, kDN4=\E[1;4B, kDN5=\E[1;5B, kDN6=\E[1;6B, kDN7=\E[1;7B,
	kRIT3=\E[1;3C, kRIT4=\E[1;4C, kRIT5=\E[1;5C, kRIT6=\E[1;6C, kRIT7=\E[1;7C,
	kLFT3=\E[1;3D, kLFT4=\E[1;4D, kLFT5=\E[1;5D, kLFT6=\E[1;6D, kLFT7=\E[1;7D,
	kHOM3=\E[1;3H, kHOM4=\E[1;4H, kHOM5=\E[1;5H, kHOM6=\E[1;6H, kHOM7=\E[1;7H,
	kEND3=\E[1;3F, kEND4=\E[1;4F, kEND5=\E[1;5F, kEND6=\E[1;6F, kEND7=\E[1;7F,
	kIC3=\E[2;3~, kIC4=\E[2;4~, kIC5=\E[2;5~, kIC6=\E[2;6~, kIC7=\E[2;7~,
	kDC3=\E[3;3~, kDC4=\E[3;4~, kDC5=\E[3;5~, kDC6=\E[3;6~, kDC7=\E[3;7~,
	kPRV3=\E[5;3~, kPRV4=\E[5;4~, kPRV5=\E[5;5~, kPRV6=\E[5;6~, kPRV7=\E[5;7~,
	kNXT3=\E[6;3~, kNXT4=\E[6;4~, kNXT5=\E[6;5~, kNXT6=\E[6;6~, kNXT7=\E[6;7~,
